cat << 'EOF' > .gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
.venv/
venv/
ENV/

# Pytest / reports
.pytest_cache/
reports/
allure-results/
allure-report/

# Node / Appium
node_modules/
npm-debug.log

# Mobile app binaries
apps/**/*.apk
apps/**/*.ipa

# OS / IDE
.DS_Store
.idea/
.vscode/

# Docker
*.log
EOF
